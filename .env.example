# ==============================================================================
# Sovereign On-Premise Agentic AI Workbench - Environment Configuration Template
# Copy this file to '.env' and configure your environment.
# Zero cloud egress - runs 100% on-premise on consumer hardware (8 GB RAM).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host LLM Runtime (Native Ollama on Windows Host)
# ------------------------------------------------------------------------------
# When running in Docker Compose, backend resolves host Ollama via host.docker.internal:11434.
# When running natively outside Docker, use http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secret (REQUIRED)
# ------------------------------------------------------------------------------
# A cryptographically strong secret key is strictly REQUIRED.
# Docker Compose will refuse to start if this is unset.
# Generate a new 256-bit secret by running:
#     python scripts/gen_secret.py --write
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Storage Paths & Telemetry Suppression
# ------------------------------------------------------------------------------
# In Docker Compose, persistent data is stored in the 'sovereign_data' named volume mounted at /app/data.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/sovereign.db
DEMO_DATABASE_URL=sqlite:///./data/demo.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Disable all cloud telemetry for 100% offline air-gapped operation
ANONYMIZED_TELEMETRY=false
CHROMA_TELEMETRY=false

# ------------------------------------------------------------------------------
# 4. Agent Loop & RAG Chunker Configuration
# ------------------------------------------------------------------------------
ENABLE_RETRY=true
MAX_AGENT_ITERATIONS=5
OLLAMA_JSON_MODE=true
PROMPT_VARIANT=hardened
REQUIRE_RETRIEVAL_BEFORE_ABSTAIN=false

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
