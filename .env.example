# Sovereign On-Premise Agentic AI Workbench Configuration

# Host LLM Runtime (native host Ollama only, no cloud egress)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120

# JWT Auth Secret
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Paths
DATABASE_URL=sqlite:///./data/sovereign.db
DEMO_DATABASE_URL=sqlite:///./data/demo.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Agent Experimentation Flags
ENABLE_RETRY=true
MAX_AGENT_ITERATIONS=5

# RAG Chunker Config
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
ANONYMIZED_TELEMETRY=false
